# Copie para infra/.env. Nunca versione infra/.env.
COMPOSE_PROJECT_NAME=observatorio-socrates
POSTGRES_IMAGE=postgres:16-alpine
N8N_IMAGE=PIN_A_REVIEWED_N8N_VERSION_HERE
POSTGRES_DB=observatorio_socrates
POSTGRES_OWNER=observatorio_owner
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_32_PLUS_CHARACTER_RANDOM_SECRET
N8N_PORT=5680
OLLAMA_BASE_URL=http://host.docker.internal:11434
